{
  "name": "preseason",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "biome check . && tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx src/server/db/pre-migrate.ts && dotenv -e .env.local -- drizzle-kit migrate && dotenv -e .env.local -- tsx src/server/db/post-migrate.ts",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed": "dotenv -e .env.local -- tsx src/server/db/seed.ts",
    "db:seed-dev": "dotenv -e .env.local -- tsx src/server/db/seed-dev-data.ts",
    "db:seed-benchmark": "dotenv -e .env.local -- tsx src/server/db/seed-benchmark-data.ts",
    "db:seed-test": "dotenv -e .env.local -- tsx src/server/db/seed-test-data.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "dev": "next dev --turbo",
    "evals:export": "dotenv -e .env.local -- tsx src/server/llm/evals/export-promptfoo.ts",
    "evals:major-tools:prepare": "dotenv -e .env.local -- tsx src/server/llm/evals/write-major-tool-eval-fixtures.ts",
    "evals:major-tools": "dotenv -e .env.local -- tsx src/server/llm/evals/run-major-tool-eval.ts",
    "evals:major-tools:broad": "dotenv -e .env.local -- tsx src/server/llm/evals/run-major-tool-eval.ts --broad",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "next build && next start",
    "setup": "pnpm install && supabase start",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:background": "node --env-file=.env.local --import tsx scripts/verify-background-smoke.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.100.14",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "openai": "^6.39.0",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/postcss": "^4.3.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.23.0"
}
